# Sovalune Infrastructure Environment Variables

# PostgreSQL
POSTGRES_DB=sovalune
POSTGRES_USER=sovalune
POSTGRES_PASSWORD=sovalune_dev_password
POSTGRES_PORT=5432

# JWT
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjogImFub24iLCAiaXNzIjogInN1cGFiYXNlIiwiaWF0IjogMTY5MDAwMDAwMH0.placeholder
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjogInNlcnZpY2Vfcm9sZSIsICJpc3MiOiAic3VwYWJhc2UiLCAiaWF0IjogMTY5MDAwMDAwMH0.placeholder

# NATS
NATS_URL=nats://nats:4222

# Sovalune Core
SOVALUNE_STORAGE_URL=postgres://sovalune:sovalune_dev_password@postgres:5432/sovalune
SOVALUNE_NATS_URL=nats://nats:4222
SOVALUNE_SERVER_HOST=0.0.0.0
SOVALUNE_SERVER_PORT=8090
SOVALUNE_WS_PORT=8091

# Model Runtime — choose one backend:
# Option 1: OpenAI API
SOVALUNE_MODEL_BACKEND=openai
SOVALUNE_MODEL_API_URL=https://api.openai.com/v1
SOVALUNE_MODEL_API_KEY=sk-your-key-here
SOVALUNE_MODEL_NAME=gpt-4o
SOVALUNE_MODEL_TIMEOUT_SECS=120

# Option 2: Local model (Ollama / llama.cpp / vLLM)
# SOVALUNE_MODEL_BACKEND=local
# SOVALUNE_MODEL_API_URL=http://host.docker.internal:11434
# SOVALUNE_MODEL_API_KEY=
# SOVALUNE_MODEL_NAME=
# SOVALUNE_MODEL_TIMEOUT_SECS=300

# Sovalune Frontend
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_WS_HOST=localhost
NEXT_PUBLIC_WS_PORT=8091
